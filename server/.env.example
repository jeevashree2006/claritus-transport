# Copy this file to server/.env and fill in the values. Never commit .env.

# API server
PORT=5000
# Address of the React app (used for CORS)
CLIENT_URL=http://localhost:5173

# Shared MySQL server - both developers point at the SAME host and database,
# each with their own MySQL user.
DB_HOST=localhost
DB_PORT=3306
DB_USER=claritas_dev1
DB_PASSWORD=change-me
DB_NAME=claritas_transport

# JWT - must be the SAME value for both developers so tokens stay valid.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Starting passwords used by `npm run db:seed` (only for users that don't exist yet)
SEED_ADMIN_PASSWORD=Admin@123
SEED_MD_PASSWORD=Md@12345
